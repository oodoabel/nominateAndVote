generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model NominationPayment {
  id              String   @id @default(cuid())
  voterName       String
  voterEmail      String
  candidateName   String
  awardCategory   String
  nominationCount Int
  amountPaid      Float
  reference       String   @unique
  status          String   @default("success")
  createdAt       DateTime @default(now())
}

model CandidateVote {
  id            String   @id @default(cuid())
  candidateId   Int
  candidateName String
  awardCategory String
  voteCount     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([candidateId, awardCategory])
}

model VoterRecord {
  id            String   @id @default(cuid())
  voterEmail    String
  awardCategory String
  candidateId   Int
  candidateName String
  createdAt     DateTime @default(now())

  @@unique([voterEmail, awardCategory])
}