generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum AwardGender {
  MALE
  FEMALE
  ALL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// ─── Candidates ───────────────────────────────────────────

model Candidate {
  id                   Int      @id @default(autoincrement())
  firstname            String
  otherNames           String
  nickname             String?
  gender               Gender
  department           String
  society              String
  image                String?
  // Profile details
  relationshipStatus   String?
  dateOfBirth          String?
  hobby                String?
  favBibleVerse        String?
  forumPaddy           String?
  forumCrush           String?
  bestCampusExperience String?
  bestLevel            String?
  mostStressfulLevel   String?
  favQuote             String?
  skill                String?
  partingWords         String?
  japaOrStay           String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  nominations  Nomination[]
  votes        Vote[]
}

// ─── Award Categories ─────────────────────────────────────

model AwardCategory {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  gender      AwardGender @default(ALL)

  createdAt   DateTime      @default(now())
  nominations Nomination[]
  votes       Vote[]
}

// ─── Nominations (paid) ───────────────────────────────────

model Nomination {
  id              Int           @id @default(autoincrement())
  candidateId     Int
  awardCategoryId Int
  count           Int           @default(1)
  amount          Int           // total amount paid in kobo (or naira)
  nominatorEmail  String?       // optional: who nominated
  nominatorName   String?

  // Paystack payment details
  transactionRef  String        @unique
  transactionStatus TransactionStatus @default(PENDING)
  paystackRef     String?

  createdAt       DateTime      @default(now())

  candidate       Candidate     @relation(fields: [candidateId], references: [id])
  awardCategory   AwardCategory @relation(fields: [awardCategoryId], references: [id])

  @@index([candidateId])
  @@index([awardCategoryId])
  @@index([transactionRef])
}

// ─── Registered Voters ────────────────────────────────────

model Voter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())
  votes     Vote[]
}

// ─── Votes (free, one per voter per award) ────────────────

model Vote {
  id              Int           @id @default(autoincrement())
  voterId         Int
  candidateId     Int
  awardCategoryId Int

  createdAt       DateTime      @default(now())

  voter           Voter         @relation(fields: [voterId], references: [id])
  candidate       Candidate     @relation(fields: [candidateId], references: [id])
  awardCategory   AwardCategory @relation(fields: [awardCategoryId], references: [id])

  // Each voter can only vote once per award category
  @@unique([voterId, awardCategoryId])
  @@index([candidateId])
  @@index([awardCategoryId])
}